<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>co.edu.unbosque</groupId>
    <artifactId>conducar</artifactId>
    <version>2.0.0</version>
    <name>conducar</name>
    <description>ConduCar - Backend MVC en Java puro con JDBC (Bases de Datos 1, Universidad El Bosque)</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Unica dependencia: el controlador JDBC de MySQL (Connector/J).
             No hay frameworks: el servidor HTTP es el del JDK y el SQL se ejecuta con JDBC. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn exec:java  ejecuta el backend desde la terminal (opcional) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>co.edu.unbosque.conducar.ConducarApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
